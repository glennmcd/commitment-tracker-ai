{
  "openapi": "3.1.0",
  "info": {
    "title": "Commitment Tracker AI",
    "description": "Extracts commitments from conversation transcripts.",
    "version": "0.3.0"
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        },
        "security": []
      }
    },
    "/analyze": {
      "post": {
        "summary": "Analyze",
        "operationId": "analyze_analyze_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AnalyzeRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnalyzeResponse"
                }
              }
            }
          },
          "422": {
            "description": "Invalid request, or the model refused it",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Too many requests from this client; see Retry-After",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "The day's spending cap is reached; see Retry-After (seconds to UTC midnight)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "502": {
            "description": "The model failed or its output was invalid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/uploads": {
      "post": {
        "summary": "Create Upload",
        "operationId": "create_upload_uploads_post",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UploadResponse"
                }
              }
            }
          },
          "429": {
            "description": "Too many requests from this client; see Retry-After",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Audio storage is not configured",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/jobs": {
      "post": {
        "summary": "Create Job",
        "operationId": "create_job_jobs_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/JobRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobResponse"
                }
              }
            }
          },
          "404": {
            "description": "The upload, sample or job does not exist",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Too many requests from this client; see Retry-After",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Invalid request, or the audio is not accepted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Jobs are not configured, or the day's spending cap is reached",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/jobs/{job_id}": {
      "get": {
        "summary": "Get Job",
        "operationId": "get_job_jobs__job_id__get",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$",
              "title": "Job Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobResponse"
                }
              }
            }
          },
          "404": {
            "description": "The upload, sample or job does not exist",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Too many requests from this client; see Retry-After",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Invalid request, or the audio is not accepted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Jobs are not configured, or the day's spending cap is reached",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/feedback": {
      "post": {
        "summary": "Create Feedback",
        "operationId": "create_feedback_feedback_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FeedbackRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FeedbackResponse"
                }
              }
            }
          },
          "404": {
            "description": "The job or the span does not exist",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "The job is not finished",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Too many requests from this client; see Retry-After",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Feedback storage is not configured",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/samples": {
      "get": {
        "summary": "List Samples",
        "operationId": "list_samples_samples_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/SampleSummary"
                  },
                  "type": "array",
                  "title": "Response List Samples Samples Get"
                }
              }
            }
          },
          "404": {
            "description": "The upload, sample or job does not exist",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Too many requests from this client; see Retry-After",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Invalid request, or the audio is not accepted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Jobs are not configured, or the day's spending cap is reached",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AnalyzeRequest": {
        "properties": {
          "transcript": {
            "items": {
              "$ref": "#/components/schemas/Turn"
            },
            "type": "array",
            "maxItems": 200,
            "minItems": 1,
            "title": "Transcript"
          },
          "call_date": {
            "type": "string",
            "format": "date",
            "title": "Call Date",
            "description": "Date of the call; relative due dates resolve from it."
          },
          "timezone": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 64
              },
              {
                "type": "null"
              }
            ],
            "title": "Timezone",
            "description": "IANA time zone of the call, if known."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "transcript",
          "call_date"
        ],
        "title": "AnalyzeRequest"
      },
      "AnalyzeResponse": {
        "properties": {
          "spans": {
            "items": {
              "$ref": "#/components/schemas/Span"
            },
            "type": "array",
            "title": "Spans"
          },
          "metadata": {
            "$ref": "#/components/schemas/Metadata"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "spans",
          "metadata"
        ],
        "title": "AnalyzeResponse"
      },
      "Due": {
        "properties": {
          "raw": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Raw",
            "description": "The due phrase exactly as spoken, such as 'by Friday'."
          },
          "resolved": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "Resolved",
            "description": "Calendar date resolved from call_date by code."
          },
          "precision": {
            "$ref": "#/components/schemas/Precision"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "raw",
          "resolved",
          "precision"
        ],
        "title": "Due"
      },
      "ErrorBody": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "details": {
            "items": {
              "$ref": "#/components/schemas/ErrorDetail"
            },
            "type": "array",
            "title": "Details",
            "default": []
          }
        },
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorBody"
      },
      "ErrorDetail": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Loc"
          },
          "msg": {
            "type": "string",
            "title": "Msg"
          },
          "type": {
            "type": "string",
            "title": "Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ErrorDetail"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          }
        },
        "type": "object",
        "required": [
          "error"
        ],
        "title": "ErrorResponse"
      },
      "FeedbackRequest": {
        "properties": {
          "job_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "title": "Job Id"
          },
          "span_index": {
            "type": "integer",
            "maximum": 999.0,
            "minimum": 0.0,
            "title": "Span Index",
            "description": "Index into the job's analysis spans."
          },
          "vote": {
            "type": "string",
            "enum": [
              "up",
              "down"
            ],
            "title": "Vote"
          },
          "consent": {
            "type": "boolean",
            "title": "Consent",
            "description": "Keep the transcript and spans for up to 90 days to improve the labels.",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "job_id",
          "span_index",
          "vote"
        ],
        "title": "FeedbackRequest",
        "description": "A vote on one span of a finished job. The label and the text come from the job record."
      },
      "FeedbackResponse": {
        "properties": {
          "transcript_kept": {
            "type": "boolean",
            "title": "Transcript Kept"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "transcript_kept"
        ],
        "title": "FeedbackResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status"
          },
          "model": {
            "type": "string",
            "title": "Model"
          },
          "prompt_version": {
            "type": "string",
            "title": "Prompt Version"
          }
        },
        "type": "object",
        "required": [
          "status",
          "model",
          "prompt_version"
        ],
        "title": "HealthResponse"
      },
      "JobRequest": {
        "properties": {
          "upload_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{32}$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Upload Id",
            "description": "From POST /uploads."
          },
          "sample_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sample Id",
            "description": "From GET /samples."
          },
          "transcript": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/Turn"
                },
                "type": "array",
                "maxItems": 200,
                "minItems": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Transcript"
          },
          "call_date": {
            "type": "string",
            "format": "date",
            "title": "Call Date",
            "description": "Date of the call; relative due dates resolve from it."
          },
          "speaker_names": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 2,
            "title": "Speaker Names",
            "description": "Names for the first and second voice heard; audio sources only."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "call_date"
        ],
        "title": "JobRequest",
        "description": "Starts a job from exactly one source: an upload, a sample clip or a typed transcript."
      },
      "JobResponse": {
        "properties": {
          "job_id": {
            "type": "string",
            "title": "Job Id"
          },
          "status": {
            "$ref": "#/components/schemas/JobStatus"
          },
          "transcript": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/Turn"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Transcript"
          },
          "analysis": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/AnalyzeResponse"
              },
              {
                "type": "null"
              }
            ]
          },
          "error_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error Code"
          },
          "latency_ms": {
            "$ref": "#/components/schemas/Latency"
          }
        },
        "type": "object",
        "required": [
          "job_id",
          "status",
          "latency_ms"
        ],
        "title": "JobResponse"
      },
      "JobStatus": {
        "type": "string",
        "enum": [
          "uploaded",
          "transcribing",
          "analyzing",
          "done",
          "failed"
        ],
        "title": "JobStatus"
      },
      "Label": {
        "type": "string",
        "enum": [
          "COMMITMENT",
          "HEDGED",
          "CONDITIONAL",
          "SUGGESTION",
          "REQUEST",
          "REPORTED",
          "REFUSAL",
          "NONE"
        ],
        "title": "Label"
      },
      "Latency": {
        "properties": {
          "upload_ms": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Upload Ms"
          },
          "transcribe_ms": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Transcribe Ms"
          },
          "analyze_ms": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Analyze Ms"
          },
          "total_ms": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Total Ms"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "Latency"
      },
      "Metadata": {
        "properties": {
          "model": {
            "type": "string",
            "title": "Model",
            "description": "Model id the request asked for."
          },
          "served_by": {
            "type": "string",
            "title": "Served By",
            "description": "Model that answered; differs after a refusal fallback."
          },
          "prompt_version": {
            "type": "string",
            "title": "Prompt Version"
          },
          "latency_ms": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Latency Ms"
          },
          "input_tokens": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Input Tokens"
          },
          "output_tokens": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Output Tokens"
          },
          "cache_creation_input_tokens": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Cache Creation Input Tokens"
          },
          "cache_read_input_tokens": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Cache Read Input Tokens"
          },
          "cost_usd": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Cost Usd",
            "description": "Estimated cost; null when the model has no known price."
          },
          "attempts": {
            "type": "integer",
            "maximum": 2.0,
            "minimum": 1.0,
            "title": "Attempts",
            "description": "Model calls made: 2 after a validation retry."
          },
          "dropped_quotes": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Dropped Quotes",
            "description": "Spans dropped because the quote was not found."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "model",
          "served_by",
          "prompt_version",
          "latency_ms",
          "input_tokens",
          "output_tokens",
          "cache_creation_input_tokens",
          "cache_read_input_tokens",
          "cost_usd",
          "attempts",
          "dropped_quotes"
        ],
        "title": "Metadata"
      },
      "Precision": {
        "type": "string",
        "enum": [
          "day",
          "week",
          "event",
          "vague",
          "none"
        ],
        "title": "Precision"
      },
      "SampleSummary": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "duration_ms": {
            "type": "integer",
            "title": "Duration Ms"
          }
        },
        "type": "object",
        "required": [
          "id",
          "title",
          "duration_ms"
        ],
        "title": "SampleSummary"
      },
      "Span": {
        "properties": {
          "turn_index": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Turn Index",
            "description": "Index of the transcript turn the quote comes from."
          },
          "label": {
            "$ref": "#/components/schemas/Label"
          },
          "owner": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Owner",
            "description": "Who is bound to act: a speaker id or a named person."
          },
          "recipient": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Recipient",
            "description": "Who the action is for."
          },
          "action": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Action",
            "description": "Short verb phrase, such as 'send revised pricing'."
          },
          "due": {
            "$ref": "#/components/schemas/Due"
          },
          "condition": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Condition",
            "description": "The stated condition; required for CONDITIONAL."
          },
          "confidence": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Confidence"
          },
          "quote": {
            "type": "string",
            "minLength": 1,
            "title": "Quote",
            "description": "Exact text from the turn."
