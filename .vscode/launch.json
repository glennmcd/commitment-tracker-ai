{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Debug current test file (Vitest)",
      "program": "${workspaceFolder}/frontend/node_modules/vitest/vitest.mjs",
      "args": ["run", "${file}", "--no-file-parallelism"],
      "cwd": "${workspaceFolder}/frontend",
      "autoAttachChildProcesses": true,
      "smartStep": true,
      "console": "integratedTerminal"
    },
    {
      "type": "debugpy",
      "request": "launch",
      "name": "Debug current test file (pytest)",
      "module": "pytest",
      "args": ["${file}", "-x", "--no-header", "-p", "no:cacheprovider"],
      "cwd": "${workspaceFolder}/backend",
      "python": "${workspaceFolder}/backend/.venv/Scripts/python.exe",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "type": "debugpy",
      "request": "launch",
      "name": "Debug all backend tests (pytest)",
      "module": "pytest",
      "args": ["-x", "--no-header"],
      "cwd": "${workspaceFolder}/backend",
      "python": "${workspaceFolder}/backend/.venv/Scripts/python.exe",
      "console": "integratedTerminal",
      "justMyCode": false
    }
  ]
}
