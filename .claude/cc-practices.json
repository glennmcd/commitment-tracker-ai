{
  "languages": ["python"],
  "format": {
    "extensions": [".py"],
    "command": ["uv", "run", "--directory", "backend", "ruff", "format", "{file}"]
  },
  "checks": {
    "lint": "uv run --directory backend ruff check --output-format concise .",
    "test": "uv run --directory backend pytest -q --tb=short",
    "format": "uv run --directory backend ruff format --check .",
    "typecheck": "uv run --directory backend mypy"    
  },
  "allowAgentCommits": true,
  "compactOutput": false
}
